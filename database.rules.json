{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "quizzes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "media": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "letters": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "password": {
          ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
          ".validate": "newData.isString() && newData.val().length >= 6"
        }
      }
    },
    "missions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "revealedAt": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && data.parent().exists()",
          ".validate": "newData.val() === now"
        }
      }
    },
    "avatars": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".validate": "newData.hasChildren(['bg']) && newData.child('bg').isString() && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length < 400000))"
      }
    },
    "raadkaart": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "config": {
        ".read": "auth != null"
      },
      "reveal": {
        ".read": "auth != null"
      },
      "last": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('members').child($uid).exists() && root.child('raadkaart/config/open').val() === true && !root.child('raadkaart/reveal').exists()",
          ".validate": "newData.child('at').val() === now && newData.child('day').isNumber() && newData.child('day').val() * 86400000 <= now + 7200000 && (newData.child('day').val() + 1) * 86400000 > now + 7200000 && (!data.exists() || newData.child('day').val() > data.child('day').val() || root.child('raadkaart/config/test').val() === true)"
        }
      },
      "guesses": {
        ".read": "auth != null && root.child('raadkaart/reveal').exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$gid": {
            ".write": "auth != null && auth.uid === $uid && root.child('members').child($uid).exists() && root.child('raadkaart/config/open').val() === true && !root.child('raadkaart/reveal').exists() && !data.exists()",
            ".validate": "newData.hasChildren(['lat', 'lng', 't', 'tk', 'day', 'at']) && newData.child('lat').val() >= -90 && newData.child('lat').val() <= 90 && newData.child('lng').val() >= -180 && newData.child('lng').val() <= 180 && newData.child('at').val() === now && newData.child('day').val() === newData.parent().parent().parent().child('last').child($uid).child('day').val() && newData.child('tk').isString() && root.child('raadkaart/edges').child(newData.child('tk').val()).exists() && newData.child('t').val() === root.child('raadkaart/edges').child(newData.child('tk').val()).child('t').val() && (((newData.child('lat').val() - root.child('raadkaart/secret').child('lat').val()) * 111.2) * ((newData.child('lat').val() - root.child('raadkaart/secret').child('lat').val()) * 111.2) + ((newData.child('lng').val() - root.child('raadkaart/secret').child('lng').val()) * 111.2 * root.child('raadkaart/secret').child('k').val()) * ((newData.child('lng').val() - root.child('raadkaart/secret').child('lng').val()) * 111.2 * root.child('raadkaart/secret').child('k').val())) >= root.child('raadkaart/edges').child(newData.child('tk').val()).child('lo2').val() && (((newData.child('lat').val() - root.child('raadkaart/secret').child('lat').val()) * 111.2) * ((newData.child('lat').val() - root.child('raadkaart/secret').child('lat').val()) * 111.2) + ((newData.child('lng').val() - root.child('raadkaart/secret').child('lng').val()) * 111.2 * root.child('raadkaart/secret').child('k').val()) * ((newData.child('lng').val() - root.child('raadkaart/secret').child('lng').val()) * 111.2 * root.child('raadkaart/secret').child('k').val())) < root.child('raadkaart/edges').child(newData.child('tk').val()).child('hi2').val()"
          }
        }
      }
    },
    "juryPins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "games": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "createdAt"
      ],
      "$code": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games').child($code).child('state').exists()",
            ".validate": "newData.hasChildren(['name', 'avatar', 'score'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "score": {
              ".validate": "newData.isNumber() && (newData.val() === 0 || root.child('admins').child(auth.uid).val() === true)"
            },
            "online": {
              ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "streak": {
              ".validate": "newData.isNumber()"
            },
            "last": {
              ".validate": "newData.hasChildren(['q'])"
            },
            "$other": {
              ".validate": false
            },
            "member": {
              ".validate": "newData.val() === true && root.child('members').child($uid).exists()"
            }
          }
        },
        "jurors": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('juryPins').child($code).val()"
          }
        },
        "jury": {
          "$qkey": {
            ".write": "auth != null && root.child('games').child($code).child('jurors').child(auth.uid).exists() && root.child('games').child($code).child('state/qkey').val() === $qkey && (root.child('games').child($code).child('state/phase').val() === 'question' || root.child('games').child($code).child('state/phase').val() === 'freeze')"
          }
        },
        "bets": {
          "$qkey": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games').child($code).child('state/phase').val() === 'question' && root.child('games').child($code).child('state/qkey').val() === $qkey && root.child('games').child($code).child('players').child($uid).exists() && !root.child('games').child($code).child('mat').child($uid).exists()",
              ".validate": "newData.isString() && newData.val().length <= 40"
            }
          }
        },
        "answers": {
          "$qkey": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games').child($code).child('state/phase').val() === 'question' && root.child('games').child($code).child('state/qkey').val() === $qkey && root.child('games').child($code).child('players').child($uid).exists() && !root.child('games').child($code).child('mat').child($uid).exists()",
              ".validate": "newData.hasChildren(['v', 'at']) && newData.child('at').val() === now && (newData.child('v').isNumber() || (newData.child('v').isString() && newData.child('v').val().length <= 80))"
            }
          }
        }
      }
    }
  }
}
