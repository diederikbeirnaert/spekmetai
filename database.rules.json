          ".indexOn": [
            "createdAt"
          ],
          "$code": {
            ".read": "auth != null",
            "players": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('weekends').child($w).child('games').child($code).child('state').exists()",
                ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.hasChildren(['name', 'avatar', 'score']))",
                "name": {
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.isString() && newData.val().length > 0 && newData.val().length <= 20)"
                },
                "avatar": {
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.isString() && newData.val().length <= 8)"
                },
                "score": {
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.isNumber() && (newData.val() === 0 || auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('weekends').child($w).child('owners').child(auth.uid).val() === true) || auth != null && root.child('weekends').child($w).child('moderators').child(auth.uid).val() === true))"
                },
                "online": {
                  ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.isBoolean())"
                },
                "joinedAt": {
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.isNumber())"
                },
                "streak": {
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.isNumber())"
                },
                "last": {
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.hasChildren(['q']))"
                },
                "$other": {
                  ".validate": false
                },
                "member": {
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.val() === true && root.child('weekends').child($w).child('members').child($uid).exists())"
                }
              }
            },
            "jurors": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('weekends').child($w).child('juryPins').child($code).val()"
              }
            },
            "jury": {
              "$qkey": {
                ".write": "auth != null && root.child('weekends').child($w).child('games').child($code).child('jurors').child(auth.uid).exists() && root.child('weekends').child($w).child('games').child($code).child('state/qkey').val() === $qkey && (root.child('weekends').child($w).child('games').child($code).child('state/phase').val() === 'question' || root.child('weekends').child($w).child('games').child($code).child('state/phase').val() === 'freeze')"
              }
            },
            "bets": {
              "$qkey": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('weekends').child($w).child('games').child($code).child('state/phase').val() === 'question' && root.child('weekends').child($w).child('games').child($code).child('state/qkey').val() === $qkey && root.child('weekends').child($w).child('games').child($code).child('players').child($uid).exists() && !root.child('weekends').child($w).child('games').child($code).child('mat').child($uid).exists()",
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.isString() && newData.val().length <= 40)"
                }
              }
            },
            "answers": {
              "$qkey": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('weekends').child($w).child('games').child($code).child('state/phase').val() === 'question' && root.child('weekends').child($w).child('games').child($code).child('state/qkey').val() === $qkey && root.child('weekends').child($w).child('games').child($code).child('players').child($uid).exists() && !root.child('weekends').child($w).child('games').child($code).child('mat').child($uid).exists()",
                  ".validate": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.hasChildren(['v', 'at']) && newData.child('at').val() === now && (newData.child('v').isNumber() || (newData.child('v').isString() && newData.child('v').val().length <= 80)))"
                }
              }
            }
          }
        }
      }
    }
  }
}
